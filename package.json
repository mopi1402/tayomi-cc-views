{
  "name": "@tayomi/cc-views",
  "version": "0.1.1-rc.21",
  "type": "module",
  "description": "Template-driven terminal rendering for Claude Code's MessageDisplay hook: data blocks in, coloured views on screen, zero tokens spent on presentation.",
  "license": "MIT",
  "files": [
    "dist",
    "views",
    "agent",
    "docs/CHEATSHEET.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "cc-views": "./dist/bin/cli.js",
    "cc-views-messagedisplay": "./dist/bin/messagedisplay.js"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "executableFiles": [
      "./dist/bin/cli.js",
      "./dist/bin/messagedisplay.js"
    ]
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "check:sidecars": "node scripts/check-sidecars.mjs",
    "check:vocabulary": "node scripts/check-vocabulary.mjs",
    "verify:pack": "pnpm build && node scripts/verify-pack.mjs",
    "gen:catalogue": "node scripts/gen-catalogue.mjs",
    "check:catalogue": "node scripts/gen-catalogue.mjs --check",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:sidecars && pnpm check:vocabulary && pnpm test && pnpm verify:pack && pnpm check:catalogue && pnpm check:skill",
    "prepublishOnly": "pnpm verify",
    "check:skill": "node scripts/check-skill.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "version": "node scripts/sync-version.mjs && git add .claude-plugin"
  },
  "dependencies": {
    "@tayomi/utils": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "eslint": "^10.6.0",
    "eslint-plugin-security": "^4.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mopi1402/tayomi-cc-views.git"
  }
}
