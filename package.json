{
  "name": "@tayomi/cc-views",
  "version": "2.6.0",
  "type": "module",
  "description": "Template-driven terminal rendering for Claude Code's MessageDisplay hook: data blocks in, coloured views on screen, zero tokens spent on presentation.",
  "keywords": [
    "claude-code",
    "claude code",
    "claude",
    "anthropic",
    "claude-code-plugin",
    "claude-code-hooks",
    "messagedisplay",
    "hooks",
    "template-engine",
    "colors",
    "colours",
    "terminal-colors",
    "layout",
    "formatting",
    "pretty-print",
    "tables",
    "mermaid",
    "diagram",
    "diagrams",
    "terminal",
    "terminal-output",
    "ansi",
    "cli"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "views",
    "agent",
    "docs/CHEATSHEET.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "cc-views": "./dist/bin/cli.js",
    "cc-views-messagedisplay": "./dist/bin/messagedisplay.js",
    "cc-views-session": "./dist/bin/session.js"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "executableFiles": [
      "./dist/bin/cli.js",
      "./dist/bin/messagedisplay.js"
    ]
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "check:sidecars": "node scripts/check-sidecars.mjs",
    "check:vocabulary": "node scripts/check-vocabulary.mjs",
    "verify:pack": "pnpm build && node scripts/verify-pack.mjs",
    "gen:catalogue": "node scripts/gen-catalogue.mjs",
    "gen:gallery": "pnpm build && node scripts/gen-gallery.mjs",
    "check:catalogue": "node scripts/gen-catalogue.mjs --check",
    "assemble:plugin": "node scripts/assemble-plugin.mjs",
    "check:plugin": "node scripts/assemble-plugin.mjs --check",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:sidecars && pnpm check:vocabulary && pnpm build && pnpm test && pnpm verify:pack && pnpm check:catalogue && pnpm check:skill && pnpm check:steering && pnpm check:plugin",
    "prepublishOnly": "node scripts/check-publisher.mjs && pnpm verify",
    "check:skill": "node scripts/check-skill.mjs",
    "check:steering": "node scripts/check-steering.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "version": "node scripts/sync-version.mjs && node scripts/assemble-plugin.mjs && git add .claude-plugin src/data/engine.ts plugin"
  },
  "dependencies": {
    "@tayomi/termaid-ts": "^0.8.2",
    "@tayomi/utils": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "eslint": "^10.6.0",
    "eslint-plugin-security": "^4.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mopi1402/tayomi-cc-views.git"
  },
  "homepage": "https://github.com/mopi1402/tayomi-cc-views#readme",
  "bugs": {
    "url": "https://github.com/mopi1402/tayomi-cc-views/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.4.0"
}
