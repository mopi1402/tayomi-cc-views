{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": false,
    "types": ["node"],
    "rootDir": "."
  },
  // Tests are typechecked like everything else: a suite is code, and a fixture that no
  // longer matches the shape it drives is a test proving nothing. What SHIPS excludes
  // them, which tsconfig.build.json states for itself rather than inheriting from here.
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
